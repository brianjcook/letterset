DirectoryIndex index.html
RewriteEngine Off

<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<FilesMatch "\.php$">
  Require all granted
</FilesMatch>
